# =============================================================================
# RVCE Campus Navigator — Environment Configuration Template
# Copy this file to `.env` and fill in your local credentials.
# NEVER commit `.env` to version control.
# =============================================================================

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME="RVCE Campus Navigation & Visitor Management Portal"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Authentication (Generate a strong 64-char secret for production)
JWT_SECRET_KEY=change-this-to-a-secure-random-64-char-hex-secret-before-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primary RDBMS — MySQL 8.0+ (Required)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DATABASE=campusguide

# Document & Geospatial Store — MongoDB 7.0+ / 9.0+ (Required)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=campusguide_nosql

# Map Configuration (Configurable Tile Provider per OSM Policy)
MAP_DEFAULT_LAT=12.923333
MAP_DEFAULT_LNG=77.499506
MAP_DEFAULT_ZOOM=18
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"

# Development Seed Account Password (used only when running database/setup_databases.py --seed)
DEV_SEED_DEFAULT_PASSWORD=RvcePortal@2026
