# =============================================================================
# RVCE Campus Navigator — Environment Configuration Template
# Copy this file to `.env` and fill in your environment-specific values.
# NEVER commit `.env` or production secrets to version control.
# =============================================================================

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME="RVCE Campus Navigation & Visitor Management Portal"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Amazon Cognito User Pools (Free Tier — OIDC + OAuth 2.0 PKCE Public Client)
# NOTE: No Client Secret and NO AWS Access Keys are ever placed in the mobile APK
#       or required by the backend JWKS verifier.
# Leave COGNITO_USER_POOL_ID empty ONLY in local `development` to use the local
# RS256 OIDC Sandbox. In `production`, COGNITO_USER_POOL_ID & CLIENT_ID are mandatory.
# =============================================================================
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=rvce-navigator://auth/callback
COGNITO_LOGOUT_URI=rvce-navigator://auth/logout
COGNITO_JWKS_CACHE_SECONDS=3600
ALLOWED_STAFF_EMAIL_DOMAIN=rvce.edu.in

# Local Development OIDC Sandbox (Automatically disabled if COGNITO_USER_POOL_ID is set;
# hard-blocked at startup when APP_ENV=production)
DEV_OIDC_SANDBOX_ENABLED=true

# Field-Level Authenticated Encryption Key (32 random bytes, Base64-encoded, AES-256-GCM)
# Generate via: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_PROTECTION_KEY_B64=

# Primary RDBMS — MySQL 8.0+ (Required; use least-privilege `campusguide_app` in prod)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DATABASE=campusguide

# Document & Geospatial Store — MongoDB 7.0+ / 9.0+ (Required)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=campusguide_nosql

# Map Configuration (Preserves Verified RVCE OpenStreetMap Baseline)
MAP_DEFAULT_LAT=12.923550
MAP_DEFAULT_LNG=77.499850
MAP_DEFAULT_ZOOM=17
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
